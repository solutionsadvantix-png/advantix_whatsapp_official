<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <header>
                    <button name="action_sync_templates_from_meta"
                            string="Sync Templates from Meta"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="state != 'connected'"/>
                    <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Meta API Credentials">
                            <field name="name"/>
                            <field name="phone_number_id"/>
                            <field name="whatsapp_business_account_id"/>
                            <field name="access_token" password="True"/>
                        </group>
                        <group string="Webhook Settings">
                            <field name="webhook_verify_token"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>