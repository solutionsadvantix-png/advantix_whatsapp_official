<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.inherit.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- إضافة زر Send WhatsApp في الـ header (يظهر فقط للفواتير المؤكدة) -->
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp"
                        type="object"
                        string="Send WhatsApp"
                        class="btn-secondary"
                        icon="fa-whatsapp"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>