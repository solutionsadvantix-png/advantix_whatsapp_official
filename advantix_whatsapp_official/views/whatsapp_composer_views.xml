<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_composer_form" model="ir.ui.view">
        <field name="name">whatsapp.composer.form</field>
        <field name="model">whatsapp.composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="body" placeholder="Type your message here..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Send" name="action_send_whatsapp" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>